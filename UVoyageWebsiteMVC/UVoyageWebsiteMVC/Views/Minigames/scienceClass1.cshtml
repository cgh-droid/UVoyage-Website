@{
    ViewData["Title"] = "Playing Minigame";
}
<style>
    * {
        font-family: sans-serif;
    }

    #beaker {
        width: 25%;
        height: 60vh;
        border: 2px solid black;
        border-radius: 10px;
        position: relative;
        margin: 20px auto;
        padding: 10px;
        font-size: xx-large;
        background-color: #f0f0f0;
        text-align: center;
    }


    .buttons {
        display: flex;
        justify-content: center;
    }

    #elements {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    #hydrogen, #carbon, #oxygen, #nitrogen, #enter, #restart{
        margin: 20px 10px 0 10px;
        padding: 10px 20px;
        font-size: 16px;
    }
    #disclaimer{
        position:absolute;
        bottom:0;
        left:1%;
    }
    .beaker-and-elements{
        margin-top: 2vh;
    }
    #goal{
        margin-top: 15px;
        text-align: center;
        padding:10px;
        background-color:white;
    }

    * {
        font-family: sans-serif;
        text-align: center;
    }

    #bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }

    #myVideo {
        z-index: -1;
        position: fixed;
        right: 0;
        bottom: 0;
        min-width: 100%;
        min-height: 100%;
    }

    .textbox {
        font-family: sans-serif;
        font-size: 1vw;
        font-weight: bold;
        color: aliceblue;
        background-image: linear-gradient(to right, darkturquoise, deepskyblue,dodgerblue);
        width: 50vw;
        height: 5vw;
        border-radius: 20px;
        padding: 0.75vw;
        text-align: left;
    }

    .textbox-container {
        z-index: 2;
        position: absolute;
        top: 75%;
        left: 50vh;
    }

    .convo-container {
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    .textbox-buttons {
        display: flex;
        justify-content: space-between;
        margin-top: 5px;
    }

    #next-button{
        background-color: deepskyblue;
        border-radius: 7px;
        border-width: 1px;
    }

    #speaker-name {
        border-radius: 10px;
        padding: 10px;
        background: linear-gradient(to right, rgb(255 162 50), rgb(255, 200, 111));
        width: fit-content;
        text-align: center;
        margin: 10px auto;
        color: aliceblue;
    }
</style>
<div class="convo-container convo">
    <div class="textbox-container convo">
        <h3 id="speaker-name" class="convo"><b></b></h3>
        <div class="textbox convo"></div>
        <div class="textbox-buttons">
            <input type="range" min="1" max="100" value="50" id="speed" class="convo">
            <button id="next-button" onclick="showText()">Next</button>
        </div>
    </div>
    <img id="bg-img" src="" />
</div>
<h1 id="goal" class="game">Create 15 unique compounds!</h1>
<p id="disclaimer" class="game">*Not accurate to reality: you cannot mix gas hydrogen, carbon, oxygen, and nitrogen gasses in school sadly</p>
<div class="beaker-and-elements game">
    <div id="beaker"> </div>
    <div id="elements">
        <button id="hydrogen" onclick="addElement('H')">H</button>
        <button id="carbon" onclick="addElement('C')">C</button>
        <button id="oxygen" onclick="addElement('O')">O</button>
        <button id="nitrogen" onclick="addElement('N')">N</button>

        <button id="enter" onclick="createCompound()">Enter</button>
        <button id="restart" onclick="clear()">Restart</button>
    </div>
</div>
<img id="myVideo" src="~/Photos/Chem game sketch.png" alt="Blue and his friend near a beaker" />
