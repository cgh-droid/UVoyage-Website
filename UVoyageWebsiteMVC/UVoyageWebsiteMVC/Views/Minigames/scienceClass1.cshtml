    let uniqueElements = [];
    addElement = (element) => {
        elements.push(element);
        var newTextContent = "";
        for (let i = 0; i < elements.length; i++) {
            newTextContent += elements[i];
            if(i != elements.length - 1) {
                newTextContent += " + ";
            }
        }
        beaker.textContent = newTextContent;
    }
    addEventListener("keydown", (event) => {
        if(event.key === "Enter") {
            createCompound();
        }
        if(event.key === "r") {
            clear();
        }
    });
    addEventListener("click", (event) => {
        if(event.target === enterButton) {
            createCompound();
        }
            if(event.target === restartButton) {
            clear();
        }
    });
    clear = () => {
        elements = [];
        beaker.textContent = "";
    }
    createCompound = () => {
        for (const compound in compounds) {
            if (arrayCount(elements, "H") === arrayCount(compounds[compound], "H") && arrayCount(elements, "O") === arrayCount(compounds[compound], "O") && arrayCount(elements, "N") === arrayCount(compounds[compound], "N") && arrayCount(elements, "C") === arrayCount(compounds[compound], "C")) {
                beaker.textContent = compound;
                if (!uniqueElements.includes(compound)) {
                    uniqueElements.push(compound);
                }
                if(uniqueElements.length == 15){
                    introDone=true;
                    toggleToConvo();
                }
                return;
            }
        }
        beaker.textContent = "No compound found";}

