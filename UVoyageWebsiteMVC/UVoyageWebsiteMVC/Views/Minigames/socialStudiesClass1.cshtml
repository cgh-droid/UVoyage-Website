        question: 'What is the supreme law of the land?',
        answers: [
          { text: 'A. The Constitution', correct: true },
          { text: 'B. The Declaration of Independence', correct: false }
        ]
      },
      {
        question: 'What is not a right in the Declaration of Independence?',
        answers: [
          { text: 'A. Life', correct: false },
          { text: 'B. Liberty', correct: false },
          { text: 'C. Prosperity', correct: true },
          { text: 'D. Pursuit of happiness', correct: false }
        ]
      },
      {
        question: 'What weakness did the Articles of Confederation have?',
        answers: [
          { text: 'A. Too much presidential power', correct: false },
          { text: 'B. No national army or strong central government', correct: true },
          { text: 'C. No taxes', correct: false },
          { text: 'D. Too much control over states', correct: false }
        ]
      },
      {
        question: 'Who is the most important writer of the Declaration of Independence?',
        answers: [
          { text: 'A. George Washington', correct: false },
          { text: 'B. Thomas Jefferson', correct: true },
          { text: 'C. James Madison', correct: false },
          { text: 'D. John Jay', correct: false }
        ]
      },
      {
        question: 'What year was the Declaration of Independence adopted?',
        answers: [
          { text: 'A. 1646', correct: false },
          { text: 'B. 1743', correct: false },
          { text: 'C. 1776', correct: true },
          { text: 'D. 1693', correct: false }
        ]
      },
      {
        question: 'What was the main purpose of the Constitutional Convention?',
        answers: [
          { text: 'A. To declare independence from Britain', correct: false },
          { text: 'B. To create a stronger national government', correct: true },
          { text: 'C. To elect the first president', correct: false },
          { text: 'D. To end the Revolutionary War', correct: false }
        ]
      },
      {
        question: 'What political party was George Washington?',
        answers: [
          { text: 'A. Republican', correct: false },
          { text: 'B. Democrat', correct: false },
          { text: 'C. Federalist', correct: false },
          { text: 'D. None', correct: true }
        ]
      },
    ]
    function toggleToConvo(){
        console.log("convo")
        gameElements.forEach(el => {
        el.style.display = 'none';
        });
        convoElements.forEach(el => {
        el.style.display ='block';
        });
        if (introDone){
            dialogue = [
            {name: "Narrator", speech:"You walk over to your teacher to submit your quiz.",bgImg: "/Photos/Ss talk giving quiz sketch.png"},
            {name: "Narrator", speech:"He then gestures you to stay where you are and grades your quiz on the spot.",bgImg: "/Photos/Ss talk grading sketch.png"},
            {name: "Narrator", speech:"After a couple minutes, he circles your answer in red ink and hands your paper back.",bgImg: "/Photos/Ss talk showing grade sketch.png"},
            {name: "Narrator", speech:"It reads "+score+"/10.",bgImg: "/Photos/Ss talk showing grade sketch.png"},
            (score>6) ? {name: "Teacher", speech:"Nice job, Blue! You're a rockstar!",bgImg: "/Photos/Ss talk showing grade sketch.png"} : {name: "Teacher", speech:"Good job, I'm sure you tried your best. Don't beat yourself up over it.",bgImg: "/Photos/Ss talk showing grade sketch.png"},
            (score>6) ? {name: "Narrator", speech:"You smile, say your thanks, and head back to your seat.",bgImg: "/Photos/Ss talk showing grade sketch.png"} : {name: "Narrator", speech:"You bring yourself to nod and head back to your seat.",bgImg: "/Photos/Ss talk showing grade sketch.png"},
            (score>6) ? {name: "Narrator", speech:"You do your thing until the bell rings.",bgImg: "/Photos/Ss talk grading other kid sketch.png"} : {name: "Narrator", speech:"You do your thing until the bell rings. The low score clouds your head a little however. Maybe you should try reflecting on the quiz.",bgImg: "/Photos/Ss talk grading other kid sketch.png"},
            (score>6) ? {name: "Narrator", speech:"Whether if that was the result of your attentiveness...",bgImg: "/Photos/Ss talk grading other kid sketch.png"} : {name: "Narrator", speech:"First off, it wasn't your fault you weren't expecting the quiz.",bgImg: "/Photos/Ss talk grading other kid sketch.png"},
            (score>6) ? {name: "Narrator", speech:"...(or just pure luck)...",bgImg: "/Photos/Ss talk grading other kid sketch.png"} : {name: "Narrator", speech:"The best thing you can do about this in the future is keeping your eye on important concepts in class.",bgImg: "/Photos/Ss talk grading other kid sketch.png"},
            (score>6) ? {name: "Narrator", speech:"...you should be proud of yourself!",bgImg: "/Photos/Ss talk grading other kid sketch.png"} : {name: "Narrator", speech:"Yesterday was the best day to improve but the next best day is today.",bgImg: "/Photos/Ss talk grading other kid sketch.png"},
            {name: "Bell", speech:"RIIIIIIIIING",bgImg: "/Photos/bell sketch.png"}
            ];
            if(score>6){
                localStorage.setItem("socialStudiesGood", "true");
                console.log(localStorage.getItem("socialStudiesGood"));
            }
            localStorage.setItem("socialStudiesDone", "true");
            showText();
        }else{
            dialogue = [
                {name: "Teacher", speech:"Hello everyone.", bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Class", speech:"Hello!",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"To start class today, I have a laid back question and a not-so-laid back rhetorical question. Which would you guys like to hear first?",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Classmate 1", speech:"Maybe the laid back one first...?",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"Do you all like popcorn?",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Classmate 1", speech:"Yeah!",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Classmate 2", speech:"Only buttered popcorn.",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Blue", speech:"Are we going to eat popcorn?",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"Yes!",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Narrator", speech:"The whole class starts whispering about the popcorn party that is to come.",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"Only after I ask my second question.",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Class", speech:"...",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"Do you all like pop quizzes?",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Class", speech:"...",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Classmate 2", speech:"Are we going to have a pop quiz?",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"Yep, our very first pop quiz of the year.",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Class", speech:".......",bgImg: "/Photos/Ss talk announce sketch.png"},
                {name: "Teacher", speech:"It's going to be alright, you guys.",bgImg: "/Photos/Ss talk one sketch.png"},
                {name: "Teacher", speech:"The quiz is about the American history we learned about this chapter.",bgImg: "/Photos/Ss talk one sketch.png"},
                {name: "Teacher", speech:"I'm sure you'll do great!",bgImg: "/Photos/Ss talk two sketch.png"},
                {name: "Teacher", speech:"Also, this probably won't take more than 20 minutes, but you'll have the whole period.",bgImg: "/Photos/Ss talk two sketch.png"},
                {name: "Teacher", speech:"I'll probably even finish grading these before then!",bgImg: "/Photos/Ss talk three sketch.png"},
                {name: "Teacher", speech:"When I give you your quiz, feel free to just start answering.",bgImg: "/Photos/Ss talk three sketch.png"},
                {name: "Teacher", speech:"Good luck everyone.",bgImg: "/Photos/Ss talk three sketch.png"},
            ]
        }
    }
            const bgImg = document.getElementById("bg-img");
        const nextButton = document.getElementById("next-button");



        let introDone=false;
        const gameElements = document.querySelectorAll('.game');
        const convoElements = document.querySelectorAll('.convo');
        function toggleToGame(){
            console.log("game")
            gameElements.forEach(el => {
            el.style.display ='block' ;
            });
            convoElements.forEach(el => {
            el.style.display = 'none';
            });
        }
        toggleToConvo();
        let currentDialogue = '';
        let dialogueIndex=0;
        function nextDialogue(){
            if(dialogueIndex < dialogue.length){
                bgImg.src = dialogue[dialogueIndex].bgImg;
                if(currentDialogue ==''){
                    currentDialogue = dialogue[0];
                }else{
                    currentDialogue=dialogue[dialogueIndex];
                }
                dialogueIndex++;
                return currentDialogue;
            }else{
                if(introDone){
                    window.location.href = "@Url.Action("minigame1", "Minigames")";
                }else{
                    toggleToGame();
                    currentDialogue = '';
                    dialogueIndex=0;
                }
                return {name:"", speech:""};
            }
        }
        function showText(){
            nextButton.style.display = 'none';
            console.log(nextButton.style.display)
            let shownDialogue = nextDialogue();
            let speed = document.getElementById("speed").value; // time for individual letters to appear
            document.querySelector("#speaker-name").textContent = shownDialogue.name;
            let text = shownDialogue.speech;
            document.querySelector(".textbox").textContent = "";
            for(let i = 0; i < text.length; i++){
                setTimeout(function() {
                    document.querySelector(".textbox").textContent += text[i];
                    if(i==text.length-1){
                        nextButton.style.display = 'block';
                        console.log(nextButton.style.display)
                    }
                }, speed * i);

            };
        };
        document.addEventListener("DOMContentLoaded", showText);
</script>